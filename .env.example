# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Model selection ----
# Options: claude-sonnet-4-6 | claude-opus-4-6
LEAH_MODEL=claude-sonnet-4-6

# ---- Google OAuth2 ----
# Download credentials.json from Google Cloud Console:
#   APIs & Services -> Credentials -> OAuth 2.0 Client ID -> Download JSON
GOOGLE_CREDENTIALS_FILE=credentials/google_credentials.json
# Path where the generated OAuth token is saved after first login
GOOGLE_TOKEN_FILE=credentials/google_token.json

# ---- User context (injected into system prompt) ----
LEAH_USER_TIMEZONE=America/New_York
LEAH_USER_NAME=Pat

# ---- Session ----
LEAH_MAX_MEMORY_MESSAGES=100

# ---- Telegram Bot ----
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
# Your Telegram user ID (from @userinfobot) — restricts the bot to only you
TELEGRAM_ALLOWED_USER_ID=879369xxxx
